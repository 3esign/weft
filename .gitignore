node_modules/
.vercel
.DS_Store
Thumbs.db
exports/*
*.stl
*.gcode
!specimens/**
presets/*.stl
presets/*.gcode
bridge/log/

# the pilot benchmark data is experiment evidence — keep it
!bridge/log/*.json

# harvested machine blocks and container templates must travel - a clean clone has to build (2026-10-01)
!exports/*_block_*.gcode
!exports/*block*.gcode
!exports/*container*.gcode.3mf
!exports/ender_start.gcode
!exports/ender_end.gcode

# STOLICA is a 170 mm body: its STL (179 MB), geometry dump (35 MB) and raw G-code (66 MB) are
# reproducible from core/weft_field_geometry.mjs. The sliced container and the evidence travel;
# the bulk does not. Rebuild command and SHA-256 are in the specimen README (2026-10-02).
specimens/2026-10-02_stolica_A1/STOLICA.stl
specimens/2026-10-02_stolica_A1/STOLICA_geometry.json
specimens/2026-10-02_stolica_A1/STOLICA.gcode

# The Ender cut of the three full bodies: display STLs (21/7/4.5 MB) and geometry dumps (8/3/2.6 MB)
# are reproducible from core/weft_solid_geometry.mjs. Toolpaths and evidence travel; the bulk does
# not. Rebuild commands and SHA-256 are in the specimen README/manifest (2026-10-02).
specimens/2026-10-02_pure_weft_ENDER/*.stl
specimens/2026-10-02_pure_weft_ENDER/*_geometry.json

# SOKOL, both cuts: 188 mm and 280 mm. Same reason — the container and the G-code are the delivery,
# the mesh and the field dump are a rebuild away (core/weft_field_geometry.mjs).
specimens/2026-10-02_sokol_A1/SOKOL.stl
specimens/2026-10-02_sokol_A1/SOKOL_geometry.json
specimens/2026-10-02_sokol_A1/SOKOL.gcode
specimens/2026-10-02_sokol_A2L/SOKOL.stl
specimens/2026-10-02_sokol_A2L/SOKOL_geometry.json
specimens/2026-10-02_sokol_A2L/SOKOL.gcode

# ZA_STAMPU/ is the PC shelf for the printer: copies of already-shipped builds, kept where
# Semir reaches for them. The specimen folder stays the single source of truth, so only the
# shelf's README travels — the binaries would be a second origin for the same bytes (2026-10-02).
ZA_STAMPU/*
!ZA_STAMPU/README.md

# Bodies 2026-10/11 (SOKOL_A2L 2nd cut, sokol_ender V2c, STOLICA_A2L, LIRA_A2L, KOCKA_REVERZ):
# mesh, field dump and raw G-code are reproducible from core/weft_field_geometry.mjs and the
# specimen build scripts; the container (.gcode.3mf), gates, manifests and evidence travel.
# Rebuild commands and SHA-256 live in each specimen README/manifest (2026-11-03).
specimens/2026-10-03_sokol_A2L/*.stl
specimens/2026-10-03_sokol_A2L/*_geometry.json
specimens/2026-10-03_sokol_A2L/*.gcode
specimens/2026-10-03_sokol_ender/v2c_package/*.gcode
specimens/2026-10-03_sokol_ender/sokol_v2c_geometry.json
# Physical phone photos live in the Svemir karantin (data/karantin-slika/weft/2026-11-03);
# originals never travel inside the repo — evidence.json keeps their SHA-256 (G-3495 gate).
specimens/2026-10-03_sokol_ender/physical_2026-10-04/originals/
specimens/2026-10-03_stolica_A2L/*.stl
specimens/2026-10-03_stolica_A2L/*_geometry.json
specimens/2026-10-03_stolica_A2L/*.gcode
specimens/2026-10-04_LIRA_A2L/package/*.gcode
specimens/2026-10-04_LIRA_A2L/probe_package/*.gcode
specimens/2026-10-04_LIRA_A2L/*_geometry.json
specimens/2026-10-04_LIRA_A2L/preview.html
specimens/2026-11-03_KOCKA_REVERZ/**/*.gcode
specimens/2026-11-03_KOCKA_REVERZ/**/*_geometry.json
# deletion staging area — its bytes never enter history
_to_delete/
