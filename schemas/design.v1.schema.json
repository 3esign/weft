{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weft://schemas/design/v1",
  "title": "WEFT DesignSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "intent", "units", "seed", "layout", "bodies", "experiment"],
  "properties": {
    "schema": { "const": "weft.design/v1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "intent": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "units": { "const": "mm" },
    "seed": { "type": "integer" },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rows", "cols", "pitch"],
      "properties": {
        "type": { "const": "grid" },
        "rows": { "type": "integer", "minimum": 1, "maximum": 8 },
        "cols": { "type": "integer", "minimum": 1, "maximum": 8 },
        "pitch": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "number", "exclusiveMinimum": 0 }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "bodies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/body" }
    },
    "experiment": { "$ref": "#/$defs/experiment" }
  },
  "$defs": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primitive", "contour", "grammar", "height", "variables", "questions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$" },
        "label": { "type": "string", "maxLength": 120 },
        "primitive": {
          "enum": ["open_wall", "dome", "membrane_coupon", "bridge_coupon", "cantilever_coupon"]
        },
        "contour": { "$ref": "#/$defs/contour" },
        "grammar": { "$ref": "#/$defs/grammar" },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "variables": { "type": "object" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "contour": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["circle", "ellipse", "rounded_square", "peanut", "clover", "polyline"] },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "rx": { "type": "number", "exclusiveMinimum": 0 },
        "ry": { "type": "number", "exclusiveMinimum": 0 },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "prefixItems": [{ "type": "number" }, { "type": "number" }],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["staple", "perpendicular", "diagonal", "sine", "eight", "spiral"] },
        "pitch": { "type": "number", "exclusiveMinimum": 0 },
        "tab": { "type": "number", "exclusiveMinimum": 0 },
        "phase": { "type": "number" }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "controlled", "varied", "measure", "hypothesis"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "controlled": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "varied": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "measure": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "hypothesis": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
